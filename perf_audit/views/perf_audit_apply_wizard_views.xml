<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="perf_audit_apply_wizard_view_form" model="ir.ui.view">
        <field name="name">perf.audit.apply.wizard.form</field>
        <field name="model">perf.audit.apply.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>This statement runs now, on its own, on the database:</p>
                <group>
                    <field name="finding_id" readonly="1"/>
                    <field name="statement" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
