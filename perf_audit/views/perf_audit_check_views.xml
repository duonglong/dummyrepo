<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="perf_audit_check_view_list" model="ir.ui.view">
        <field name="name">perf.audit.check.list</field>
        <field name="model">perf.audit.check</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="severity"/>
                <field name="active_check" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="perf_audit_check_view_form" model="ir.ui.view">
        <field name="name">perf.audit.check.form</field>
        <field name="model">perf.audit.check</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" readonly="id"/>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="severity"/>
                        <field name="active_check"/>
                    </group>
                    <field name="threshold_ids">
                        <list editable="bottom" create="false" delete="false">
                            <field name="name" readonly="1"/>
                            <field name="key" column_invisible="1"/>
                            <field name="unit" readonly="1"/>
                            <field name="value"/>
                            <field name="default_value"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="perf_audit_check_action" model="ir.actions.act_window">
        <field name="name">Checks</field>
        <field name="res_model">perf.audit.check</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
