<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="record_change_model_view_list" model="ir.ui.view">
        <field name="name">record.change.model.list</field>
        <field name="model">record.change.model</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="is_followed"/>
            </list>
        </field>
    </record>

    <record id="record_change_model_view_form" model="ir.ui.view">
        <field name="name">record.change.model.form</field>
        <field name="model">record.change.model</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <group>
                        <field name="model_id" readonly="1" force_save="1"/>
                        <field name="is_followed"/>
                    </group>
                    <field name="field_ids">
                        <list editable="bottom">
                            <field name="field_id"
                                   domain="[('model_id', '=', parent.model_id), ('store', '=', True), ('ttype', 'in', ['char', 'text', 'integer', 'float', 'monetary', 'date', 'datetime', 'boolean', 'selection', 'html', 'many2one', 'many2many']), ('name', 'not in', ['id', 'create_uid', 'create_date', 'write_uid', 'write_date', 'display_name', 'access_token']), ('name', 'not =like', 'message_%'), ('name', 'not =like', 'activity_%'), ('name', 'not =like', 'website_message_%'), ('name', 'not =like', 'access_%')]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="is_followed"/>
                            <field name="is_sensitive"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="record_change_model_action" model="ir.actions.act_window">
        <field name="name">Change tracker</field>
        <field name="res_model">record.change.model</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="record_change_menu_settings"
              name="Change tracker"
              parent="base.menu_administration"
              action="record_change_model_action"
              sequence="90"/>
</odoo>
