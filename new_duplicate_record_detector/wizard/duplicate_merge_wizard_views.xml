<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="duplicate_merge_wizard_view_form" model="ir.ui.view">
        <field name="name">duplicate.merge.wizard.form</field>
        <field name="model">duplicate.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge preview" create="0">
                <sheet>
                    <field name="res_model" invisible="1"/>
                    <field name="group_id" invisible="1"/>
                    <field name="kept_res_id" invisible="1"/>
                    <group>
                        <field name="archive_names" string="Will be archived"/>
                    </group>
                    <separator string="Records to merge"/>
                    <field name="record_line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="include"/>
                            <field name="name" readonly="1"/>
                            <field name="record_create_date" readonly="1"/>
                            <field name="is_kept"/>
                            <button name="action_keep_this" type="object" string="Keep this one"
                                    icon="fa-check" invisible="is_kept or not include"
                                    groups="new_duplicate_record_detector.group_duplicate_manager"/>
                        </list>
                    </field>
                    <separator string="Values after the merge"/>
                    <field name="value_line_ids" readonly="1">
                        <list create="0" delete="0" decoration-info="is_filled">
                            <field name="field_label"/>
                            <field name="kept_value"/>
                            <field name="source_name"/>
                            <field name="is_filled"/>
                        </list>
                    </field>
                    <separator string="Linked documents that will move"/>
                    <field name="link_line_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="model_label"/>
                            <field name="count"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_merge" type="object" string="Confirm merge" class="btn-primary"
                            groups="new_duplicate_record_detector.group_duplicate_manager"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_merge_duplicate_contacts" model="ir.actions.act_window">
        <field name="name">Merge duplicates</field>
        <field name="res_model">duplicate.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[Command.link(ref('new_duplicate_record_detector.group_duplicate_manager'))]"/>
    </record>

    <record id="action_merge_duplicate_products" model="ir.actions.act_window">
        <field name="name">Merge duplicates</field>
        <field name="res_model">duplicate.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[Command.link(ref('new_duplicate_record_detector.group_duplicate_manager'))]"/>
    </record>
</odoo>
