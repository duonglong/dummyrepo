<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_procurement_sourcing_event" model="ir.sequence">
            <field name="name">Sourcing event</field>
            <field name="code">procurement.sourcing.event</field>
            <field name="prefix">SE/</field>
            <field name="padding">4</field>
        </record>
    </data>

    <!-- Requirements: FR-SPM-0032 -->
    <record id="mail_template_sourcing_invitation" model="mail.template">
        <field name="name">Sourcing event: invitation to quote</field>
        <field name="model_id" ref="model_procurement_sourcing_event"/>
        <field name="subject">Request for quotation {{ object.name }}: {{ object.title }}</field>
        <field name="email_from">{{ (object.buyer_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="body_html" type="html">
<div>
    <p>Hello,</p>
    <p><t t-out="object.company_id.name"/> invites you to quote for <t t-out="object.name"/>: <t t-out="object.title"/>.</p>
    <p>Quotations are accepted until <t t-out="format_datetime(object.deadline, tz='UTC', dt_format='yyyy-MM-dd HH:mm')"/> (UTC).</p>
    <p><a t-att-href="object.get_base_url() + '/my/procurement'">Open your supplier portal</a></p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!-- Requirements: FR-SPM-0033 -->
    <record id="mail_template_sourcing_deadline" model="mail.template">
        <field name="name">Sourcing event: new deadline</field>
        <field name="model_id" ref="model_procurement_sourcing_event"/>
        <field name="subject">New deadline for {{ object.name }}: {{ object.title }}</field>
        <field name="email_from">{{ (object.buyer_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="body_html" type="html">
<div>
    <p>Hello,</p>
    <p>The deadline of <t t-out="object.name"/>: <t t-out="object.title"/> is now
       <t t-out="format_datetime(object.deadline, tz='UTC', dt_format='yyyy-MM-dd HH:mm')"/> (UTC).</p>
    <p><a t-att-href="object.get_base_url() + '/my/procurement'">Open your supplier portal</a></p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!-- Requirements: FR-SPM-0042 -->
    <record id="mail_template_sourcing_cancelled" model="mail.template">
        <field name="name">Sourcing event: cancelled</field>
        <field name="model_id" ref="model_procurement_sourcing_event"/>
        <field name="subject">Cancelled: {{ object.name }}: {{ object.title }}</field>
        <field name="email_from">{{ (object.buyer_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="body_html" type="html">
<div>
    <p>Hello,</p>
    <p><t t-out="object.company_id.name"/> cancelled <t t-out="object.name"/>: <t t-out="object.title"/>.
       Quotations are no longer accepted.</p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!-- Requirements: FR-SPM-0036 -->
    <record id="mail_template_sourcing_revision" model="mail.template">
        <field name="name">Sourcing event: revised quotation requested</field>
        <field name="model_id" ref="model_procurement_sourcing_negotiation"/>
        <field name="subject">Revised quotation requested for {{ object.event_id.name }}: {{ object.event_id.title }}</field>
        <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="body_html" type="html">
<div>
    <p>Hello,</p>
    <p><t t-out="object.company_id.name"/> asks you to revise your quotation for
       <t t-out="object.event_id.name"/>: <t t-out="object.event_id.title"/>.</p>
    <p t-out="object.note_to_supplier"/>
    <p>You can submit a new version until
       <t t-out="format_datetime(object.new_deadline, tz='UTC', dt_format='yyyy-MM-dd HH:mm')"/> (UTC).</p>
    <p><a t-att-href="object.get_base_url() + '/my/procurement'">Open your supplier portal</a></p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
