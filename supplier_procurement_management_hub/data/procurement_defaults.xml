<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Requirements: FR-SPM-0108 -->
    <record id="document_type_tax_certificate" model="procurement.document.type">
        <field name="name">Tax certificate</field>
        <field name="needs_expiry" eval="True"/>
        <field name="portal_upload" eval="True"/>
    </record>
    <record id="document_type_business_license" model="procurement.document.type">
        <field name="name">Business license</field>
        <field name="needs_expiry" eval="True"/>
        <field name="portal_upload" eval="True"/>
    </record>
    <record id="document_type_insurance" model="procurement.document.type">
        <field name="name">Insurance certificate</field>
        <field name="needs_expiry" eval="True"/>
        <field name="portal_upload" eval="True"/>
        <field name="reminder_days">45</field>
    </record>
    <record id="document_type_quality_certificate" model="procurement.document.type">
        <field name="name">Quality certificate</field>
        <field name="needs_expiry" eval="True"/>
        <field name="portal_upload" eval="True"/>
    </record>
    <record id="document_type_bank_letter" model="procurement.document.type">
        <field name="name">Bank details letter</field>
        <field name="portal_upload" eval="True"/>
    </record>
</odoo>
