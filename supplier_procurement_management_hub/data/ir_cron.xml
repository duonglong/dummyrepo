<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Requirements: FR-SPM-0012, FR-SPM-0096 -->
    <record id="ir_cron_spm_requalification" model="ir.cron">
        <field name="name">Procurement hub: supplier re-qualification</field>
        <field name="model_id" ref="model_procurement_job"/>
        <field name="state">code</field>
        <field name="code">model._spm_run('requalification')</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="job_spm_requalification" model="procurement.job">
        <field name="name">Supplier re-qualification</field>
        <field name="code">requalification</field>
        <field name="sequence">10</field>
        <field name="cron_id" ref="ir_cron_spm_requalification"/>
    </record>
</odoo>
