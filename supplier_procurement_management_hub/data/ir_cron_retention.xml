<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0110, FR-SPM-0096 -->
    <record id="ir_cron_spm_retention" model="ir.cron">
        <field name="name">Procurement hub: retention</field>
        <field name="model_id" ref="model_procurement_job"/>
        <field name="state">code</field>
        <field name="code">model._spm_run('retention')</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <data noupdate="1">
        <record id="job_spm_retention" model="procurement.job">
            <field name="name">Retention of portal accounts and files</field>
            <field name="code">retention</field>
            <field name="sequence">90</field>
            <field name="cron_id" ref="ir_cron_spm_retention"/>
        </record>
    </data>
</odoo>
