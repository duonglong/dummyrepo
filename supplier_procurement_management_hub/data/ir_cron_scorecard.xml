<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0083, FR-SPM-0096 -->
    <record id="ir_cron_spm_scorecard" model="ir.cron">
        <field name="name">Procurement hub: supplier scorecards</field>
        <field name="model_id" ref="model_procurement_job"/>
        <field name="state">code</field>
        <field name="code">model._spm_run('scorecard')</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <data noupdate="1">
        <record id="job_spm_scorecard" model="procurement.job">
            <field name="name">Supplier scorecards</field>
            <field name="code">scorecard</field>
            <field name="sequence">40</field>
            <field name="cron_id" ref="ir_cron_spm_scorecard"/>
        </record>
    </data>
</odoo>
