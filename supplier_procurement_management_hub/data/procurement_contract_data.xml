<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Requirements: FR-SPM-0062, FR-SPM-0064 -->
    <record id="seq_procurement_contract" model="ir.sequence">
        <field name="name">Purchase contract</field>
        <field name="code">procurement.contract</field>
        <field name="prefix">CTR</field>
        <field name="padding">5</field>
    </record>
    <record id="ir_cron_spm_contract_states" model="ir.cron">
        <field name="name">Procurement hub: contract start and expiry</field>
        <field name="model_id" ref="model_procurement_contract"/>
        <field name="state">code</field>
        <field name="code">model._spm_update_states()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
