<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0051, FR-SPM-0096 -->
    <record id="ir_cron_spm_approval_escalation" model="ir.cron">
        <field name="name">Procurement hub: approval escalation</field>
        <field name="model_id" ref="model_procurement_job"/>
        <field name="state">code</field>
        <field name="code">model._spm_run('approval_escalation')</field>
        <field name="user_id" ref="base.user_root"/>
