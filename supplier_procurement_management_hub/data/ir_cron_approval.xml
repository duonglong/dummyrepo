        <field name="interval_type">hours</field>
    </record>
    <data noupdate="1">
        <record id="job_spm_approval_escalation" model="procurement.job">
            <field name="name">Approval escalation</field>
            <field name="code">approval_escalation</field>
            <field name="sequence">30</field>
            <field name="cron_id" ref="ir_cron_spm_approval_escalation"/>
        </record>
    </data>
</odoo>
