<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0106 (eight roles; the eighth, the supplier portal user, is base.group_portal) -->
    <record id="module_category_procurement_hub" model="ir.module.category">
        <field name="name">Procurement Hub</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_procurement_hub" model="res.groups.privilege">
        <field name="name">Procurement Hub</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_procurement_hub"/>
    </record>

    <record id="group_spm_requester" model="res.groups">
        <field name="name">Requester</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_procurement_hub"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_spm_department_manager" model="res.groups">
        <field name="name">Department manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_procurement_hub"/>
        <field name="implied_ids" eval="[(4, ref('group_spm_requester'))]"/>
    </record>

    <record id="group_spm_buyer" model="res.groups">
        <field name="name">Buyer</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_procurement_hub"/>
        <field name="implied_ids" eval="[(4, ref('group_spm_requester')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="group_spm_finance" model="res.groups">
        <field name="name">Finance reviewer</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_procurement_hub"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_spm_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_procurement_hub"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_allow_export'))]"/>
    </record>

    <record id="group_spm_manager" model="res.groups">
        <field name="name">Procurement manager</field>
        <field name="sequence">60</field>
        <field name="privilege_id" ref="res_groups_privilege_procurement_hub"/>
        <field name="implied_ids" eval="[(4, ref('group_spm_buyer')), (4, ref('group_spm_department_manager')), (4, ref('base.group_allow_export'))]"/>
    </record>

    <record id="group_spm_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">70</field>
        <field name="privilege_id" ref="res_groups_privilege_procurement_hub"/>
        <field name="implied_ids" eval="[(4, ref('group_spm_manager')), (4, ref('group_spm_finance')), (4, ref('group_spm_auditor'))]"/>
        <field name="implied_by_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
