<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0008, FR-SPM-0011, FR-SPM-0014 -->
    <record id="res_partner_view_form_spm" model="ir.ui.view">
        <field name="name">res.partner.form.spm</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header invisible="not id or not is_company">
                    <button name="action_spm_open_status_wizard" string="Change status" type="object"
                            groups="supplier_procurement_management_hub.group_spm_manager"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Procurement" name="spm_procurement"
                      groups="supplier_procurement_management_hub.group_spm_buyer">
                    <group>
                        <group>
                            <field name="spm_status_id" readonly="True"/>
                            <field name="spm_status_kind" widget="badge"/>
                            <field name="spm_supplier_type_id"/>
                            <field name="spm_product_category_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="spm_requalification_date"/>
                            <field name="spm_responsible_user_id"/>
                            <field name="spm_risk_level"/>
                            <field name="spm_qualification_score"/>
                            <label for="spm_open_action_count"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="spm_open_action_count" class="oe_inline"/>
                                <button name="action_spm_open_actions" type="object" string="Open" class="btn-link p-0"
                                        invisible="not spm_open_action_count"/>
                            </div>
                        </group>
                    </group>
                    <group>
                        <field name="spm_compliance_state" invisible="not spm_compliance_state"/>
                        <field name="spm_compliance_summary" invisible="not spm_compliance_summary"/>
                    </group>
                    <field name="spm_document_ids" context="{'default_partner_id': id}">
                        <list decoration-danger="validity_state in ('expired', 'rejected')"
                              decoration-warning="validity_state == 'expiring'">
                            <field name="document_type_id"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="verification_state"/>
                            <field name="validity_state"/>
                        </list>
                    </field>
                </page>
                <page string="Bank changes" name="spm_bank_changes"
                      groups="supplier_procurement_management_hub.group_spm_buyer,supplier_procurement_management_hub.group_spm_finance,supplier_procurement_management_hub.group_spm_manager">
                    <field name="spm_change_ids">
                        <list decoration-warning="state == 'pending'" decoration-muted="state == 'refused'">
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="state" widget="badge"/>
                            <field name="field_label"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="restricted_old_value"/>
                            <field name="restricted_new_value"/>
                            <field name="origin"/>
                            <field name="reason"/>
                            <button name="action_spm_verify" type="object" string="Verify"
                                    invisible="state != 'pending'"
                                    groups="supplier_procurement_management_hub.group_spm_finance,supplier_procurement_management_hub.group_spm_manager"/>
                            <button name="action_spm_refuse" type="object" string="Refuse"
                                    invisible="state != 'pending'"
                                    groups="supplier_procurement_management_hub.group_spm_finance,supplier_procurement_management_hub.group_spm_manager"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="procurement_supplier_directory_action" model="ir.actions.act_window">
        <field name="name">Supplier directory</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('spm_is_supplier', '=', True)]</field>
        <field name="help">No supplier yet.</field>
    </record>

    <record id="menu_spm_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_spm_department_manager'))]"/>
    </record>
    <menuitem id="menu_spm_supplier_directory" name="Supplier directory" parent="menu_spm_root" sequence="8"
              action="procurement_supplier_directory_action"
              groups="group_spm_buyer,group_spm_department_manager,group_spm_manager,group_spm_finance,group_spm_auditor,group_spm_admin"/>
</odoo>
