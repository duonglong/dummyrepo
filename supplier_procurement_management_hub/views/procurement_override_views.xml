<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0013 -->
    <record id="procurement_override_view_list" model="ir.ui.view">
        <field name="name">procurement.override.list</field>
        <field name="model">procurement.override</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="kind"/>
                <field name="action"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="reason"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <record id="procurement_override_action" model="ir.actions.act_window">
        <field name="name">Overrides</field>
        <field name="res_model">procurement.override</field>
        <field name="view_mode">list</field>
    </record>
    <record id="purchase_order_form_spm_override" model="ir.ui.view">
        <field name="name">purchase.order.form.spm.override</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <button id="draft_confirm" position="after">
                <button name="action_spm_open_override_wizard" type="object" string="Override"
                        invisible="state not in ('draft', 'sent', 'to approve')"
                        groups="supplier_procurement_management_hub.group_spm_manager"/>
            </button>
        </field>
    </record>
</odoo>
