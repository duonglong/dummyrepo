<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0109 -->
    <record id="procurement_audit_log_view_list" model="ir.ui.view">
        <field name="name">procurement.audit.log.list</field>
        <field name="model">procurement.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="date desc, id desc">
                <field name="date"/>
                <field name="user_id"/>
                <field name="company_id" optional="show"/>
                <field name="event"/>
                <field name="res_model" optional="hide"/>
                <field name="record_name"/>
                <field name="old_values" optional="hide"/>
                <field name="new_values" optional="hide"/>
                <field name="comment"/>
            </list>
        </field>
    </record>

    <record id="procurement_audit_log_view_form" model="ir.ui.view">
        <field name="name">procurement.audit.log.form</field>
        <field name="model">procurement.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="company_id"/>
                            <field name="event"/>
                        </group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="record_name"/>
                        </group>
                    </group>
                    <group>
                        <field name="old_values"/>
                        <field name="new_values"/>
                        <field name="comment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="procurement_audit_log_view_search" model="ir.ui.view">
        <field name="name">procurement.audit.log.search</field>
        <field name="model">procurement.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="record_name"/>
                <field name="user_id"/>
                <field name="event"/>
                <field name="res_model"/>
                <filter string="This month" name="this_month"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Kind" name="group_event" context="{'group_by': 'event'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Month" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="procurement_audit_log_action" model="ir.actions.act_window">
        <field name="name">Audit trail</field>
        <field name="res_model">procurement.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="help">No audit entry yet.</field>
    </record>

    <menuitem id="menu_spm_root" name="Procurement Hub" sequence="45"
              groups="group_spm_auditor,group_spm_manager,group_spm_admin"/>
    <menuitem id="menu_spm_configuration" name="Configuration" parent="menu_spm_root" sequence="90"
              groups="group_spm_auditor,group_spm_manager,group_spm_admin"/>
    <menuitem id="menu_spm_audit_log" name="Audit trail" parent="menu_spm_configuration" sequence="80"
              action="procurement_audit_log_action"
              groups="group_spm_auditor,group_spm_manager,group_spm_admin"/>
</odoo>
