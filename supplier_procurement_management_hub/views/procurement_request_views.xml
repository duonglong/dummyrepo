<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0030 -->
    <record id="procurement_request_view_list" model="ir.ui.view">
        <field name="name">procurement.request.list</field>
        <field name="model">procurement.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'ordered'">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="needed_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="procurement_request_view_form" model="ir.ui.view">
        <field name="name">procurement.request.form</field>
        <field name="model">procurement.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_spm_submit" type="object" string="Submit" class="btn-primary"
                            invisible="state != 'draft' or not id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="requester_id" readonly="state != 'draft'" groups="supplier_procurement_management_hub.group_spm_buyer"/>
                            <field name="department_id"/>
                            <field name="needed_date"/>
                        </group>
                        <group>
                            <field name="buyer_id" groups="supplier_procurement_management_hub.group_spm_buyer"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="Reason"/>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="procurement_request_view_search" model="ir.ui.view">
        <field name="name">procurement.request.search</field>
        <field name="model">procurement.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="procurement_request_action" model="ir.actions.act_window">
        <field name="name">Purchase requests</field>
        <field name="res_model">procurement.request</field>
        <field name="view_mode">list,form</field>
        <field name="help">Create a purchase request.</field>
    </record>
    <menuitem id="menu_spm_requests" name="Purchase requests" sequence="44"
              action="procurement_request_action"
              groups="group_spm_requester"/>
</odoo>
