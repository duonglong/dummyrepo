<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0108 -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.spm</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Procurement Hub" name="supplier_procurement_management_hub"
                     groups="supplier_procurement_management_hub.group_spm_admin">
                    <block title="Supplier control">
                        <setting>
                            <field name="spm_supplier_control"/>
                        </setting>
                        <setting>
                            <field name="spm_risk_low_action"/>
                        </setting>
                        <setting>
                            <field name="spm_risk_medium_action"/>
                        </setting>
                        <setting>
                            <field name="spm_risk_high_action"/>
                        </setting>
                        <setting>
                            <field name="spm_risk_medium_from"/>
                        </setting>
                        <setting>
                            <field name="spm_risk_high_from"/>
                        </setting>
                    </block>
                    <block title="Delays">
                        <setting><field name="spm_on_time_tolerance_days"/></setting>
                        <setting><field name="spm_delivery_escalation_days"/></setting>
                        <setting><field name="spm_duplicate_bill_days"/></setting>
                        <setting><field name="spm_quote_reminder_days"/></setting>
                        <setting><field name="spm_closing_soon_days"/></setting>
                        <setting><field name="spm_requalification_months"/></setting>
                    </block>
                    <block title="Retention">
                        <setting><field name="spm_portal_inactivity_days"/></setting>
                        <setting><field name="spm_document_retention_years"/></setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
