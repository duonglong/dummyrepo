<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0108, BR-SPM-0005 -->
    <record id="procurement_supplier_status_view_list" model="ir.ui.view">
        <field name="name">procurement.supplier.status.list</field>
        <field name="model">procurement.supplier.status</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="default_for_kind"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="procurement_supplier_status_action" model="ir.actions.act_window">
        <field name="name">Supplier statuses</field>
        <field name="res_model">procurement.supplier.status</field>
        <field name="view_mode">list</field>
        <field name="help">Add a status and choose its kind.</field>
    </record>

    <record id="procurement_document_type_view_list" model="ir.ui.view">
        <field name="name">procurement.document.type.list</field>
        <field name="model">procurement.document.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="needs_expiry"/>
                <field name="reminder_days"/>
                <field name="portal_upload"/>
            </list>
        </field>
    </record>
    <record id="procurement_document_type_action" model="ir.actions.act_window">
        <field name="name">Document types</field>
        <field name="res_model">procurement.document.type</field>
        <field name="view_mode">list</field>
        <field name="help">Add the document types suppliers must provide.</field>
    </record>

    <record id="procurement_supplier_type_view_form" model="ir.ui.view">
        <field name="name">procurement.supplier.type.form</field>
        <field name="model">procurement.supplier.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="required_document_type_ids" widget="many2many_tags"/>
                    </group>
                    <field name="field_ids">
                        <list editable="bottom">
                            <field name="field_key"/>
                            <field name="visibility"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="procurement_supplier_type_view_list" model="ir.ui.view">
        <field name="name">procurement.supplier.type.list</field>
        <field name="model">procurement.supplier.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="required_document_type_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="procurement_supplier_type_action" model="ir.actions.act_window">
        <field name="name">Supplier types</field>
        <field name="res_model">procurement.supplier.type</field>
        <field name="view_mode">list,form</field>
        <field name="help">Add a supplier type.</field>
    </record>

    <record id="procurement_portal_field_view_list" model="ir.ui.view">
        <field name="name">procurement.portal.field.list</field>
        <field name="model">procurement.portal.field</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="field_id" options="{'no_create': True}"/>
                <field name="editable"/>
            </list>
        </field>
    </record>
    <record id="procurement_portal_field_action" model="ir.actions.act_window">
        <field name="name">Portal fields</field>
        <field name="res_model">procurement.portal.field</field>
        <field name="view_mode">list</field>
        <field name="help">Choose the supplier fields shown in the portal.</field>
    </record>

    <record id="procurement_reason_wizard_view_form" model="ir.ui.view">
        <field name="name">procurement.reason.wizard.form</field>
        <field name="model">procurement.reason.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="res_model" invisible="True"/>
                    <field name="res_ids" invisible="True"/>
                    <field name="action" invisible="True"/>
                    <field name="status_kind" invisible="True"/>
                    <field name="status_id" invisible="action != 'set_status'"
                           required="action == 'set_status'" options="{'no_create': True}"/>
                    <field name="reason"
                           required="action == 'override' or status_kind in ('suspended', 'blocked')"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_spm_supplier_status" name="Supplier statuses" parent="menu_spm_configuration"
              sequence="10" action="procurement_supplier_status_action"
              groups="group_spm_manager,group_spm_admin"/>
    <menuitem id="menu_spm_supplier_type" name="Supplier types" parent="menu_spm_configuration"
              sequence="20" action="procurement_supplier_type_action"
              groups="group_spm_manager,group_spm_admin"/>
    <menuitem id="menu_spm_document_type" name="Document types" parent="menu_spm_configuration"
              sequence="30" action="procurement_document_type_action"
              groups="group_spm_manager,group_spm_admin"/>
    <menuitem id="menu_spm_portal_field" name="Portal fields" parent="menu_spm_configuration"
              sequence="40" action="procurement_portal_field_action"
              groups="group_spm_manager,group_spm_admin"/>
</odoo>
