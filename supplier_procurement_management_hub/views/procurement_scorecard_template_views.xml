<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0082 -->
    <record id="procurement_scorecard_template_view_list" model="ir.ui.view">
        <field name="name">procurement.scorecard.template.list</field>
        <field name="model">procurement.scorecard.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="period"/>
                <field name="good_from"/>
                <field name="acceptable_from"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="procurement_scorecard_template_view_form" model="ir.ui.view">
        <field name="name">procurement.scorecard.template.form</field>
        <field name="model">procurement.scorecard.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="period"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="True"/>
                        </group>
                        <group>
                            <field name="good_from"/>
                            <field name="acceptable_from"/>
                            <field name="review_threshold"/>
                        </group>
                    </group>
                    <field name="metric_ids">
                        <list editable="bottom">
                            <field name="metric"/>
                            <field name="weight"/>
                            <field name="review_threshold"/>
                        </list>
                    </field>
                    <group>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="product_category_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="procurement_scorecard_template_action" model="ir.actions.act_window">
        <field name="name">Scorecard templates</field>
        <field name="res_model">procurement.scorecard.template</field>
        <field name="view_mode">list,form</field>
        <field name="help">Add a template with the metrics and weights of a scorecard.</field>
    </record>
    <menuitem id="menu_spm_scorecard_template" name="Scorecard templates" parent="menu_spm_configuration"
              sequence="74" action="procurement_scorecard_template_action"
              groups="group_spm_manager,group_spm_admin"/>
</odoo>
