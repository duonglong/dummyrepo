<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0071, FR-SPM-0072, FR-SPM-0073, FR-SPM-0074, BR-SPM-0014 -->
    <record id="procurement_reconciliation_view_list" model="ir.ui.view">
        <field name="name">procurement.reconciliation.list</field>
        <field name="model">procurement.reconciliation</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state == 'error'" decoration-warning="state == 'review'"
                  decoration-success="state == 'matched'">
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="method"/>
                <field name="state" widget="badge"/>
                <field name="refreshed_date"/>
            </list>
        </field>
    </record>
    <record id="procurement_reconciliation_view_form" model="ir.ui.view">
        <field name="name">procurement.reconciliation.form</field>
        <field name="model">procurement.reconciliation</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_spm_run_matching" type="object" string="Run matching"
                            groups="supplier_procurement_management_hub.group_spm_finance,supplier_procurement_management_hub.group_spm_manager,supplier_procurement_management_hub.group_spm_admin"
                            invisible="move_id.state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="move_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="method"/>
                            <field name="refreshed_date"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="product_id"/>
                            <field name="ordered_qty"/>
                            <field name="received_qty"/>
                            <field name="billed_qty"/>
                            <field name="qty_difference"/>
                            <field name="qty_within_tolerance"/>
                            <field name="ordered_price"/>
                            <field name="billed_price"/>
                            <field name="price_difference"/>
                            <field name="amount_difference"/>
                            <field name="price_within_tolerance"/>
                            <field name="order_currency_id" optional="hide"/>
                            <field name="currency_id" optional="hide"/>
                            <field name="ordered_tax_ids" widget="many2many_tags" optional="hide"/>
                            <field name="billed_tax_ids" widget="many2many_tags" optional="hide"/>
                            <field name="ordered_uom_id" optional="hide"/>
                            <field name="billed_uom_id" optional="hide"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="procurement_reconciliation_action" model="ir.actions.act_window">
        <field name="name">Bill matching</field>
        <field name="res_model">procurement.reconciliation</field>
        <field name="view_mode">list,form</field>
        <field name="help">Saving a draft vendor bill linked to an order matches it here.</field>
    </record>
    <record id="account_move_unmatched_action" model="ir.actions.act_window">
        <field name="name">Unmatched bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('spm_match_state', '=', 'unmatched')]</field>
    </record>

    <record id="procurement_matching_policy_view_list" model="ir.ui.view">
        <field name="name">procurement.matching.policy.list</field>
        <field name="model">procurement.matching.policy</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="partner_id"/>
                <field name="product_category_id"/>
                <field name="applies_to"/>
                <field name="method"/>
            </list>
        </field>
    </record>
    <record id="procurement_matching_policy_action" model="ir.actions.act_window">
        <field name="name">Matching policies</field>
        <field name="res_model">procurement.matching.policy</field>
        <field name="view_mode">list</field>
        <field name="help">Add a policy for a vendor, a category or the whole company.</field>
    </record>

    <record id="procurement_matching_tolerance_view_list" model="ir.ui.view">
        <field name="name">procurement.matching.tolerance.list</field>
        <field name="model">procurement.matching.tolerance</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="kind"/>
                <field name="partner_id"/>
                <field name="product_category_id"/>
                <field name="amount_from"/>
                <field name="amount_to"/>
                <field name="percent"/>
                <field name="absolute_amount"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="procurement_matching_tolerance_action" model="ir.actions.act_window">
        <field name="name">Matching tolerances</field>
        <field name="res_model">procurement.matching.tolerance</field>
        <field name="view_mode">list</field>
        <field name="help">Add the price and quantity differences that need no exception.</field>
    </record>

    <record id="procurement_exception_route_view_list" model="ir.ui.view">
        <field name="name">procurement.exception.route.list</field>
        <field name="model">procurement.exception.route</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="kind"/>
                <field name="owner_role"/>
                <field name="owner_id"/>
                <field name="requires_approval"/>
            </list>
        </field>
    </record>
    <record id="procurement_exception_route_action" model="ir.actions.act_window">
        <field name="name">Exception routes</field>
        <field name="res_model">procurement.exception.route</field>
        <field name="view_mode">list</field>
        <field name="help">Add who owns each kind of matching exception.</field>
    </record>

    <record id="menu_spm_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_spm_finance')), (4, ref('group_spm_buyer'))]"/>
    </record>
    <menuitem id="menu_spm_reconciliation" name="Bill matching" parent="menu_spm_root" sequence="50"
              groups="group_spm_buyer,group_spm_finance,group_spm_auditor,group_spm_manager,group_spm_admin"/>
    <menuitem id="menu_spm_bill_matching" name="Matched bills" parent="menu_spm_reconciliation" sequence="10"
              action="procurement_reconciliation_action"/>
    <menuitem id="menu_spm_unmatched_bills" name="Unmatched bills" parent="menu_spm_reconciliation" sequence="20"
              action="account_move_unmatched_action"
              groups="group_spm_finance,group_spm_manager,group_spm_admin"/>
    <menuitem id="menu_spm_matching_policy" name="Matching policies" parent="menu_spm_configuration"
              sequence="50" action="procurement_matching_policy_action"
              groups="group_spm_manager,group_spm_admin"/>
    <menuitem id="menu_spm_matching_tolerance" name="Matching tolerances" parent="menu_spm_configuration"
              sequence="60" action="procurement_matching_tolerance_action"
              groups="group_spm_manager,group_spm_admin"/>
    <menuitem id="menu_spm_exception_route" name="Exception routes" parent="menu_spm_configuration"
              sequence="70" action="procurement_exception_route_action"
              groups="group_spm_manager,group_spm_admin"/>
</odoo>
