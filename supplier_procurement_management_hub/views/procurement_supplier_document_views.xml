<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0007, FR-SPM-0008 -->
    <record id="procurement_supplier_document_view_list" model="ir.ui.view">
        <field name="name">procurement.supplier.document.list</field>
        <field name="model">procurement.supplier.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="validity_state in ('expired', 'rejected')"
                  decoration-warning="validity_state == 'expiring'">
                <field name="partner_id"/>
                <field name="document_type_id"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="verification_state"/>
                <field name="validity_state"/>
            </list>
        </field>
    </record>

    <record id="procurement_supplier_document_view_form" model="ir.ui.view">
        <field name="name">procurement.supplier.document.form</field>
        <field name="model">procurement.supplier.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="verification_state" widget="statusbar" options="{'clickable': True}"
                           groups="supplier_procurement_management_hub.group_spm_buyer"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="document_type_id"/>
                            <field name="attachment_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="validity_state"/>
                        </group>
                    </group>
                    <group>
                        <field name="reviewer_id"/>
                        <field name="review_date"/>
                        <field name="review_comment" required="verification_state == 'rejected'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="procurement_supplier_document_view_search" model="ir.ui.view">
        <field name="name">procurement.supplier.document.search</field>
        <field name="model">procurement.supplier.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="document_type_id"/>
                <filter name="to_verify" string="To verify" domain="[('verification_state', '=', 'to_verify')]"/>
                <filter name="expired" string="Expired" domain="[('validity_state', '=', 'expired')]"/>
                <filter name="expiring" string="Expiring" domain="[('validity_state', '=', 'expiring')]"/>
            </search>
        </field>
    </record>

    <record id="procurement_supplier_document_action" model="ir.actions.act_window">
        <field name="name">Supplier documents</field>
        <field name="res_model">procurement.supplier.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No supplier document yet</p>
        </field>
    </record>

    <record id="procurement_supplier_document_to_verify_action" model="ir.actions.act_window">
        <field name="name">Documents to verify</field>
        <field name="res_model">procurement.supplier.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('verification_state', '=', 'to_verify'), ('is_current', '=', True)]</field>
        <field name="help">No document waits for verification.</field>
    </record>

    <menuitem id="menu_spm_documents_to_verify" name="Documents to verify" parent="menu_spm_root" sequence="14"
              action="procurement_supplier_document_to_verify_action"
              groups="group_spm_buyer,group_spm_manager,group_spm_admin"/>
</odoo>
