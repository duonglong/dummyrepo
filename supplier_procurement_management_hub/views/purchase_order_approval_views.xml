<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0047, FR-SPM-0048, FR-SPM-0049, FR-SPM-0052, FR-SPM-0053 -->
    <record id="procurement_approval_decision_view_list" model="ir.ui.view">
        <field name="name">procurement.approval.decision.list</field>
        <field name="model">procurement.approval.decision</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="approver_id"/>
                <field name="on_behalf_of_id" optional="show"/>
                <field name="decision" widget="badge" decoration-success="decision == 'approved'"
                       decoration-danger="decision == 'rejected'"/>
                <field name="comment"/>
                <field name="revision"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>
    <record id="procurement_approval_step_view_list" model="ir.ui.view">
        <field name="name">procurement.approval.step.list</field>
        <field name="model">procurement.approval.step</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="state in ('waiting', 'cancelled')">
                <field name="sequence"/>
                <field name="name"/>
                <field name="mode"/>
                <field name="approver_ids" widget="many2many_tags"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'" decoration-info="state == 'open'"/>
                <button name="action_spm_open_approve_wizard" type="object" string="Approve" icon="check"
                        invisible="state != 'open'" class="text-success"/>
                <button name="action_spm_open_reject_wizard" type="object" string="Reject" icon="close"
                        invisible="state != 'open'" class="text-danger"/>
            </list>
        </field>
    </record>
    <record id="procurement_approval_request_view_form" model="ir.ui.view">
        <field name="name">procurement.approval.request.form</field>
        <field name="model">procurement.approval.request</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="revision"/>
                            <field name="submitted_by_id"/>
                            <field name="submitted_date"/>
                            <field name="decided_date"/>
                            <field name="cancel_reason" invisible="not cancel_reason"/>
                        </group>
                        <group>
                            <field name="snapshot_partner_id"/>
                            <field name="snapshot_amount"/>
                            <field name="snapshot_currency_id" invisible="1"/>
                            <field name="cumulated_amount"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Steps" name="steps">
                            <field name="step_ids" context="{'list_view_ref': 'supplier_procurement_management_hub.procurement_approval_step_view_list'}"/>
                        </page>
                        <page string="Decisions" name="decisions">
                            <field name="decision_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="procurement_approval_request_view_list" model="ir.ui.view">
        <field name="name">procurement.approval.request.list</field>
        <field name="model">procurement.approval.request</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="state == 'cancelled'">
                <field name="revision"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'" decoration-info="state == 'pending'"/>
                <field name="snapshot_partner_id"/>
                <field name="snapshot_amount"/>
                <field name="snapshot_currency_id" column_invisible="1"/>
                <field name="submitted_by_id"/>
                <field name="submitted_date"/>
                <field name="cancel_reason" optional="show"/>
            </list>
        </field>
    </record>
    <record id="procurement_approval_approve_wizard_view_form" model="ir.ui.view">
        <field name="name">procurement.approval.approve.wizard.form</field>
        <field name="model">procurement.approval.approve.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="step_id" invisible="1"/>
                    <field name="comment"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Approve" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="procurement_approval_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">procurement.approval.reject.wizard.form</field>
        <field name="model">procurement.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="step_id" invisible="1"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="purchase_order_form_spm_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.spm.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <button id="draft_confirm" position="before">
                <button name="action_spm_submit_approval" type="object" string="Submit for approval"
                        class="btn-primary"
                        invisible="state not in ('draft', 'sent') or spm_approval_state in ('pending', 'approved')"
                        groups="supplier_procurement_management_hub.group_spm_buyer"/>
            </button>
            <xpath expr="//field[@name='state']" position="before">
                <field name="spm_approval_state" widget="badge" invisible="spm_approval_state == 'none'"
                       decoration-success="spm_approval_state == 'approved'"
                       decoration-danger="spm_approval_state == 'rejected'"
                       decoration-info="spm_approval_state == 'pending'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Approval" name="spm_approval" invisible="spm_approval_state == 'none'">
                    <group>
                        <field name="spm_revision"/>
                    </group>
                    <field name="spm_approval_request_ids"
                           context="{'list_view_ref': 'supplier_procurement_management_hub.procurement_approval_request_view_list'}"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
