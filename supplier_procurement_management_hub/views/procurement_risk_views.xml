<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: BR-SPM-0017, BR-SPM-0020, FR-SPM-0088, FR-SPM-0089 -->
    <record id="procurement_risk_category_view_list" model="ir.ui.view">
        <field name="name">procurement.risk.category.list</field>
        <field name="model">procurement.risk.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="weight"/>
                <field name="questionnaire_id" context="{'default_purpose': 'risk'}"/>
                <field name="uses_documents"/>
            </list>
        </field>
    </record>
    <record id="procurement_risk_category_action" model="ir.actions.act_window">
        <field name="name">Risk categories</field>
        <field name="res_model">procurement.risk.category</field>
        <field name="view_mode">list</field>
        <field name="help">Add a risk category with its weight.</field>
    </record>

    <record id="procurement_risk_assessment_view_form" model="ir.ui.view">
        <field name="name">procurement.risk.assessment.form</field>
        <field name="model">procurement.risk.assessment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_spm_complete" type="object" string="Complete" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="supplier_procurement_management_hub.group_spm_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="assessed_by_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="score" invisible="state == 'draft'"/>
                            <field name="level" invisible="state == 'draft'"/>
                            <field name="is_current" invisible="state == 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Categories" name="categories">
                            <field name="category_score_ids" readonly="state != 'draft'">
                                <list>
                                    <field name="category_id"/>
                                    <field name="weight"/>
                                    <field name="score"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="category_id"/>
                                        <field name="weight"/>
                                        <field name="score"/>
                                    </group>
                                    <field name="answer_ids">
                                        <list editable="bottom">
                                            <field name="question_id"/>
                                            <field name="option_id" domain="[('question_id', '=', question_id)]"/>
                                            <field name="points"/>
                                        </list>
                                    </field>
                                    <field name="document_ids" widget="many2many_tags"/>
                                    <field name="evidence"/>
                                </form>
                            </field>
                        </page>
                        <page string="Screenings" name="screenings">
                            <field name="screening_ids" context="{'default_partner_id': partner_id}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="procurement_risk_assessment_view_list" model="ir.ui.view">
        <field name="name">procurement.risk.assessment.list</field>
        <field name="model">procurement.risk.assessment</field>
        <field name="arch" type="xml">
            <list decoration-muted="not is_current and state == 'done'">
                <field name="partner_id"/>
                <field name="date"/>
                <field name="score"/>
                <field name="level" widget="badge"/>
                <field name="state"/>
                <field name="is_current" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="procurement_risk_assessment_action" model="ir.actions.act_window">
        <field name="name">Risk assessments</field>
        <field name="res_model">procurement.risk.assessment</field>
        <field name="view_mode">list,form</field>
        <field name="help">Assess a supplier's risk.</field>
    </record>

    <record id="procurement_screening_view_list" model="ir.ui.view">
        <field name="name">procurement.screening.list</field>
        <field name="model">procurement.screening</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="kind"/>
                <field name="source"/>
                <field name="result"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="origin"/>
                <field name="note"/>
            </list>
        </field>
    </record>
    <record id="procurement_screening_view_form" model="ir.ui.view">
        <field name="name">procurement.screening.form</field>
        <field name="model">procurement.screening</field>
        <field name="arch" type="xml">
            <form edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="id"/>
                            <field name="kind" readonly="id"/>
                            <field name="source" readonly="id"/>
                            <field name="result" readonly="id"/>
                        </group>
                        <group>
                            <field name="date" readonly="id"/>
                            <field name="user_id"/>
                            <field name="origin"/>
                            <field name="assessment_id" readonly="id"/>
                        </group>
                    </group>
                    <field name="note" readonly="id"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="procurement_screening_action" model="ir.actions.act_window">
        <field name="name">Screenings</field>
        <field name="res_model">procurement.screening</field>
        <field name="view_mode">list,form</field>
        <field name="help">Record a screening outcome.</field>
    </record>

    <menuitem id="menu_spm_risk_assessment" name="Risk assessments" parent="menu_spm_root" sequence="60"
              action="procurement_risk_assessment_action"
              groups="group_spm_auditor,group_spm_manager,group_spm_admin"/>
    <menuitem id="menu_spm_screening" name="Screenings" parent="menu_spm_root" sequence="62"
              action="procurement_screening_action"
              groups="group_spm_auditor,group_spm_manager,group_spm_admin"/>
    <menuitem id="menu_spm_risk_category" name="Risk categories" parent="menu_spm_configuration" sequence="60"
              action="procurement_risk_category_action"
              groups="group_spm_auditor,group_spm_manager,group_spm_admin"/>
</odoo>
