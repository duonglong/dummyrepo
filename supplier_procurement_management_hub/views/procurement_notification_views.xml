<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: BR-SPM-0019, FR-SPM-0094 -->
    <record id="procurement_notification_log_view_list" model="ir.ui.view">
        <field name="name">procurement.notification.log.list</field>
        <field name="model">procurement.notification.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="kind"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="recipient_partner_id"/>
                <field name="due_date"/>
            </list>
        </field>
    </record>
    <record id="procurement_notification_log_action" model="ir.actions.act_window">
        <field name="name">Notifications sent</field>
        <field name="res_model">procurement.notification.log</field>
        <field name="view_mode">list</field>
        <field name="help">Reminders and escalations appear here once the jobs have sent them.</field>
    </record>
    <menuitem id="menu_spm_notification_log" name="Notifications sent" parent="menu_spm_configuration"
              sequence="74" action="procurement_notification_log_action"
              groups="group_spm_auditor,group_spm_manager,group_spm_admin"/>

    <record id="procurement_contract_view_form_reminder" model="ir.ui.view">
        <field name="name">procurement.contract.form.reminder</field>
        <field name="model">procurement.contract</field>
        <field name="inherit_id" ref="procurement_contract_view_form"/>
        <field name="arch" type="xml">
            <field name="notice_days" position="after">
                <field name="reminder_days" readonly="state not in ('draft', 'revision')"/>
            </field>
        </field>
    </record>
</odoo>
