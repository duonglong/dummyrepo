<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0039 -->
    <record id="procurement_award_wizard_view_form" model="ir.ui.view">
        <field name="name">procurement.award.wizard.form</field>
        <field name="model">procurement.award.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="event_id" force_save="1"/>
                    <field name="mode" widget="radio"/>
                    <field name="response_id" invisible="mode != 'whole'" required="mode == 'whole'"
                           options="{'no_create': True}"/>
                    <field name="rationale"/>
                </group>
                <field name="line_choice_ids" invisible="mode != 'per_line'">
                    <list editable="bottom" create="0" delete="0">
                        <field name="event_id" column_invisible="True"/>
                        <field name="event_line_id" force_save="1"/>
                        <field name="response_id" options="{'no_create': True}"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Award" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
