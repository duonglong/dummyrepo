<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0001, FR-SPM-0002, FR-SPM-0003 -->
    <template id="onboarding_refused" name="Supplier onboarding: link refused">
        <t t-call="portal.frontend_layout">
            <div id="wrap" class="container py-5">
                <div class="alert alert-warning" role="alert"><t t-out="message"/></div>
            </div>
        </t>
    </template>

    <template id="onboarding_done" name="Supplier onboarding: submitted">
        <t t-call="portal.frontend_layout">
            <div id="wrap" class="container py-5">
                <div class="alert alert-success" role="alert">Your application was submitted.</div>
            </div>
        </t>
    </template>

    <template id="onboarding_form" name="Supplier onboarding: application form">
        <t t-call="portal.frontend_layout">
            <div id="wrap" class="container py-4">
                <h1 class="h3">Supplier application
                    <span class="badge text-bg-secondary ms-2 align-middle"><t t-out="state_label"/></span>
                </h1>
                <div t-if="application.state == 'changes_requested' and application.change_request_comment"
                     class="alert alert-warning" role="alert"><t t-out="application.change_request_comment"/></div>
                <div t-foreach="errors" t-as="error" class="alert alert-danger" role="alert"><t t-out="error"/></div>
                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label class="form-label">E-mail</label>
                        <input type="text" class="form-control" t-att-value="application.email" readonly="readonly"/>
                    </div>
                    <div t-foreach="text_fields" t-as="item" class="mb-3">
                        <label t-attf-for="spm_#{item[1]}" class="form-label"><t t-out="item[2]"/><span t-if="item[1] in required_fields" class="text-danger"> *</span></label>
                        <input type="text" t-att-name="item[1]" t-attf-id="spm_#{item[1]}"
                               class="form-control" t-att-value="application[item[1]]"
                               t-att-required="'required' if item[1] in required_fields else None"/>
                    </div>
                    <div t-if="rules['street'] != 'hidden'" class="mb-3">
                        <label for="spm_country_id" class="form-label">Country</label>
                        <select name="country_id" id="spm_country_id" class="form-select">
                            <option value=""/>
                            <option t-foreach="countries" t-as="country" t-att-value="country.id"
                                    t-att-selected="country == application.country_id"><t t-out="country.name"/></option>
                        </select>
                    </div>
                    <div t-if="rules['categories'] != 'hidden'" class="mb-3">
                        <label for="spm_categories" class="form-label">Product categories<span t-if="rules['categories'] == 'required'" class="text-danger"> *</span></label>
                        <select name="product_category_ids" id="spm_categories" class="form-select" multiple="multiple"
                                t-att-required="'required' if rules['categories'] == 'required' else None">
                            <option t-foreach="categories" t-as="category" t-att-value="category.id"
                                    t-att-selected="category in application.product_category_ids"><t t-out="category.display_name"/></option>
                        </select>
                    </div>
                    <div t-if="rules['operating_locations'] != 'hidden'" class="mb-3">
                        <label for="spm_operating_locations" class="form-label">Operating locations<span t-if="rules['operating_locations'] == 'required'" class="text-danger"> *</span></label>
                        <textarea name="operating_locations" id="spm_operating_locations" class="form-control"
                                  t-att-required="'required' if rules['operating_locations'] == 'required' else None"><t t-out="application.operating_locations"/></textarea>
                    </div>
                    <div t-if="rules['contacts'] != 'hidden'" class="mb-3">
                        <h2 class="h5">Contacts</h2>
                        <div t-foreach="contacts" t-as="contact" class="row g-2 mb-2">
                            <t t-set="index" t-value="contact.id if contact else 'new%s' % (contact_index - len(application.contact_ids))"/>
                            <div class="col"><input type="text" class="form-control" t-attf-name="contact_name_#{index}" placeholder="Name" t-att-value="contact and contact.name"/></div>
                            <div class="col"><input type="text" class="form-control" t-attf-name="contact_email_#{index}" placeholder="E-mail" t-att-value="contact and contact.email"/></div>
                            <div class="col"><input type="text" class="form-control" t-attf-name="contact_phone_#{index}" placeholder="Phone" t-att-value="contact and contact.phone"/></div>
                            <div class="col"><input type="text" class="form-control" t-attf-name="contact_function_#{index}" placeholder="Function" t-att-value="contact and contact.function"/></div>
                        </div>
                    </div>
                    <div t-if="required_documents" class="mb-3">
                        <h2 class="h5">Documents</h2>
                        <div t-foreach="required_documents" t-as="doc_type" class="mb-2">
                            <label t-attf-for="spm_document_#{doc_type.id}" class="form-label">
                                <t t-out="doc_type.name"/><span class="text-danger"> *</span>
                                <span t-if="doc_type in uploaded" class="badge text-bg-success ms-2">Uploaded</span>
                            </label>
                            <input type="file" class="form-control" t-attf-name="document_#{doc_type.id}"
                                   t-attf-id="spm_document_#{doc_type.id}" accept="application/pdf,image/png,image/jpeg"/>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-secondary" formnovalidate="formnovalidate">Save</button>
                    <button type="submit" name="submit" value="1" class="btn btn-primary">Submit</button>
                </form>
            </div>
        </t>
    </template>
</odoo>
