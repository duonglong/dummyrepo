<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-SPM-0015, FR-SPM-0018, FR-SPM-0019, NFR-SPM-0003 -->
    <template id="portal_home_profile_link" name="Supplier portal: edit profile link"
              inherit_id="supplier_procurement_management_hub.portal_home">
        <xpath expr="//h2[hasclass('h5')]" position="before">
            <a class="btn btn-secondary btn-sm" href="/my/procurement/profile">Edit profile</a>
        </xpath>
    </template>

    <template id="portal_profile" name="Supplier portal: profile">
        <t t-call="portal.portal_layout">
            <div class="container py-3" id="spm_portal_profile">
                <h1 class="h3" t-out="supplier_name"/>
                <div class="alert alert-danger" role="alert" t-foreach="errors" t-as="error" t-out="error"/>
                <div class="alert alert-success" role="status" t-if="saved">Saved</div>
                <form action="/my/procurement/profile" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3" t-foreach="fields" t-as="field">
                        <label class="form-label" t-att-for="field['name']" t-out="field['label']"/>
                        <select t-if="field['type'] == 'selection'" class="form-select" t-att-name="field['name']" t-att-id="field['name']">
                            <option value=""/>
                            <option t-foreach="field['options']" t-as="option" t-att-value="option"
                                    t-att-selected="option == field['value']" t-out="field['options'][option]"/>
                        </select>
                        <select t-elif="field['type'] == 'boolean'" class="form-select" t-att-name="field['name']" t-att-id="field['name']">
                            <option value="0" t-att-selected="not field['value']">No</option>
                            <option value="1" t-att-selected="field['value']">Yes</option>
                        </select>
                        <input t-else="" class="form-control" t-att-type="'date' if field['type'] == 'date' else 'text'"
                               t-att-name="field['name']" t-att-id="field['name']" t-att-value="field['value']"/>
                    </div>
                    <h2 class="h5 mt-4">Bank account</h2>
                    <div class="mb-3">
                        <label class="form-label" for="bank_account_number">Account number</label>
                        <input class="form-control" type="text" name="bank_account_number" id="bank_account_number"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="bank_name">Bank</label>
                        <input class="form-control" type="text" name="bank_name" id="bank_name"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="bank_bic">BIC</label>
                        <input class="form-control" type="text" name="bank_bic" id="bank_bic"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="bank_holder">Account holder</label>
                        <input class="form-control" type="text" name="bank_holder" id="bank_holder"/>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
                <h2 class="h5 mt-4">Upload a document</h2>
                <form action="/my/procurement/documents/upload" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label class="form-label" for="document_type_id">Document type</label>
                        <select class="form-select" name="document_type_id" id="document_type_id" required="required">
                            <option t-foreach="document_types" t-as="document_type" t-att-value="document_type.id"
                                    t-out="document_type.name"/>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="issue_date">Issue date</label>
                        <input class="form-control" type="date" name="issue_date" id="issue_date"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="expiry_date">Expiry date</label>
                        <input class="form-control" type="date" name="expiry_date" id="expiry_date"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="file">File (PDF, PNG or JPEG, up to <t t-out="max_mb"/> MB)</label>
                        <input class="form-control" type="file" name="file" id="file" accept=".pdf,.png,.jpg,.jpeg" required="required"/>
                    </div>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </form>
            </div>
        </t>
    </template>
</odoo>
