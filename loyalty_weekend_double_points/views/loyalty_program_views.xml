<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loyalty_program_view_form_weekend" model="ir.ui.view">
        <field name="name">loyalty.program.form.weekend.double.points</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
        <field name="arch" type="xml">
            <field name="portal_visible" position="after">
                <field name="weekend_double_points" invisible="program_type != 'loyalty'"/>
            </field>
        </field>
    </record>
</odoo>
