<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-DPA-0003, FR-DPA-0004, FR-DPA-0005, FR-DPA-0007, FR-DPA-0008, FR-DPA-0009, FR-DPA-0010, FR-DPA-0013, FR-DPA-0014, FR-DPA-0015 -->
    <record id="dpa_snapshot_view_list" model="ir.ui.view">
        <field name="name">dpa.snapshot.list</field>
        <field name="model">dpa.snapshot</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="model_label"/>
                <field name="run_date"/>
                <field name="origin"/>
                <field name="user_id"/>
                <field name="record_count"/>
            </list>
        </field>
    </record>

    <record id="dpa_snapshot_view_form" model="ir.ui.view">
        <field name="name">dpa.snapshot.form</field>
        <field name="model">dpa.snapshot</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="profile_name"/>
                            <field name="model_label"/>
                            <field name="run_date"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="record_count"/>
                            <field name="empty_threshold"/>
                            <field name="outdated_days"/>
                            <field name="company_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="field_line_ids">
                        <list>
                            <field name="field_label"/>
                            <field name="field_type"/>
                            <field name="filled_count"/>
                            <field name="empty_count"/>
                            <field name="completeness"/>
                            <field name="distinct_count"/>
                            <field name="flag_labels"/>
                        </list>
                        <form>
                            <group>
                                <field name="field_label"/>
                                <field name="field_type"/>
                                <field name="distinct_count"/>
                                <field name="unused_values" invisible="not unused_values"/>
                                <field name="field_type" invisible="1"/>
                                <field name="main_pattern" invisible="not main_pattern"/>
                                <field name="main_pattern_share" invisible="not main_pattern"/>
                                <field name="format_note" nolabel="1" colspan="2" invisible="not format_note"/>
                                <field name="range_computed" invisible="1"/>
                                <field name="range_low" invisible="not range_computed"/>
                                <field name="range_high" invisible="not range_computed"/>
                                <field name="range_note" nolabel="1" colspan="2" invisible="not range_note"/>
                            </group>
                            <field name="value_ids">
                                <list>
                                    <field name="value_label"/>
                                    <field name="count"/>
                                    <field name="share"/>
                                </list>
                            </field>
                            <field name="finding_ids" invisible="not finding_ids">
                                <list>
                                    <field name="kind"/>
                                    <field name="value_label"/>
                                    <field name="record_name"/>
                                    <field name="res_model" column_invisible="1"/>
                                    <field name="res_id" widget="many2one_reference"/>
                                </list>
                            </field>
                            <field name="more_count" invisible="1"/>
                            <field name="more_note" nolabel="1" invisible="not more_count"/>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dpa_snapshot_action" model="ir.actions.act_window">
        <field name="name">Snapshots</field>
        <field name="res_model">dpa.snapshot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_saved', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Run a profile and save its report</p>
        </field>
    </record>
</odoo>
