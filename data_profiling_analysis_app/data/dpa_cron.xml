<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Requirements: FR-DPA-0021, FR-DPA-0022 -->
    <record id="dpa_cron_take_snapshots" model="ir.cron">
        <field name="name">Data Profiling: take scheduled snapshots</field>
        <field name="model_id" ref="model_dpa_profile"/>
        <field name="state">code</field>
        <field name="code">model._cron_take_snapshots()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
