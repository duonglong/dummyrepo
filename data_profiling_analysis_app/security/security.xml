<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requirements: FR-DPA-0032, NFR-SEC-0001 -->
    <record id="module_category_data_profiling" model="ir.module.category">
        <field name="name">Data Profiling</field>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_data_profiling" model="res.groups.privilege">
        <field name="name">Data Profiling</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_data_profiling"/>
    </record>

    <record id="group_data_profiling" model="res.groups">
        <field name="name">Data Profiling</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_data_profiling"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
