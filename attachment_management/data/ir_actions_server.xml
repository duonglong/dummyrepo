<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_attachment_download_zip" model="ir.actions.server">
        <field name="name">Download as zip</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="binding_model_id" ref="base.model_ir_attachment"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['attachment.zip.download']._request_from_attachments(records)</field>
    </record>
</odoo>
