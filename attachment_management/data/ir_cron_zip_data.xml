<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_am_zip_build" model="ir.cron">
        <field name="name">Attachment zips: prepare large downloads</field>
        <field name="model_id" ref="model_attachment_zip_download"/>
        <field name="state">code</field>
        <field name="code">model._cron_build_queued()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_am_zip_cleanup" model="ir.cron">
        <field name="name">Attachment zips: clean up</field>
        <field name="model_id" ref="model_attachment_zip_download"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>
