<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attachment_zip_download_list" model="ir.ui.view">
        <field name="name">attachment.zip.download.list</field>
        <field name="model">attachment.zip.download</field>
        <field name="arch" type="xml">
            <list string="My zip downloads" create="0" edit="0" delete="0">
                <field name="zip_name"/>
                <field name="file_count"/>
                <field name="total_size"/>
                <field name="state" widget="badge"/>
                <field name="ready_date"/>
                <field name="error" optional="hide"/>
                <button name="action_download" type="object" string="Download" icon="fa-download"
                        invisible="state != 'ready'"/>
            </list>
        </field>
    </record>

    <record id="action_attachment_zip_download" model="ir.actions.act_window">
        <field name="name">My zip downloads</field>
        <field name="res_model">attachment.zip.download</field>
        <field name="view_mode">list</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No zip downloads.</p>
            <p>Large zips you ask for appear here when they are ready.</p>
        </field>
    </record>

    <menuitem id="menu_attachment_zip_download" name="My zip downloads"
              parent="menu_attachment_management_root"
              action="action_attachment_zip_download" sequence="20"/>
</odoo>
