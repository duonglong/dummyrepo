<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="record_reminder_execution_view_list" model="ir.ui.view">
        <field name="name">record.reminder.execution.list</field>
        <field name="model">record.reminder.execution</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="state == 'failed'">
                <field name="executed_at"/>
                <field name="rule_id"/>
                <field name="record_name"/>
                <field name="reminder_date"/>
                <field name="channel"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'"
                       decoration-danger="state == 'failed'"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="record_reminder_execution_view_form" model="ir.ui.view">
        <field name="name">record.reminder.execution.form</field>
        <field name="model">record.reminder.execution</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_record" type="object" string="Open record"
                            invisible="not res_id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="rule_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="record_name"/>
                            <field name="reminder_date"/>
                        </group>
                        <group>
                            <field name="channel"/>
                            <field name="partner_ids" widget="many2many_tags"/>
                            <field name="executed_at"/>
                            <field name="state"/>
                            <field name="attempt"/>
                        </group>
                    </group>
                    <group invisible="not error_message">
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="record_reminder_execution_view_search" model="ir.ui.view">
        <field name="name">record.reminder.execution.search</field>
        <field name="model">record.reminder.execution</field>
        <field name="arch" type="xml">
            <search>
                <field name="rule_id"/>
                <field name="record_name"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="record_reminder_execution_action" model="ir.actions.act_window">
        <field name="name">Reminder History</field>
        <field name="res_model">record.reminder.execution</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No reminder sent yet.</p>
        </field>
    </record>
</odoo>
