<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ipr_reject_wizard_view_form_approve" model="ir.ui.view">
        <field name="name">ipr.reject.wizard.form.approve</field>
        <field name="model">ipr.reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="move_id" invisible="1"/>
                <field name="decision" invisible="1"/>
                <group>
                    <field name="reason" string="Comment" placeholder="Optional"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Approve" class="btn-primary"
                            data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ipr_reject_wizard_view_form_reject" model="ir.ui.view">
        <field name="name">ipr.reject.wizard.form.reject</field>
        <field name="model">ipr.reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="move_id" invisible="1"/>
                <field name="decision" invisible="1"/>
                <group>
                    <field name="reason" string="Reason" required="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject" class="btn-primary"
                            data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ipr_reject_wizard_action_approve" model="ir.actions.act_window">
        <field name="name">Approve</field>
        <field name="res_model">ipr.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ipr_reject_wizard_view_form_approve"/>
        <field name="target">new</field>
    </record>

    <record id="ipr_reject_wizard_action_reject" model="ir.actions.act_window">
        <field name="name">Reject</field>
        <field name="res_model">ipr.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ipr_reject_wizard_view_form_reject"/>
        <field name="target">new</field>
    </record>

    <record id="ipr_account_move_view_form_decide" model="ir.ui.view">
        <field name="name">account.move.form.ipr.decide</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="ipr_can_decide" invisible="1"/>
                <button name="%(ipr_reject_wizard_action_approve)d" type="action" string="Approve"
                        class="oe_highlight"
                        context="{'default_move_id': id, 'default_decision': 'approve'}"
                        invisible="not ipr_can_decide"/>
                <button name="%(ipr_reject_wizard_action_reject)d" type="action" string="Reject"
                        context="{'default_move_id': id, 'default_decision': 'reject'}"
                        invisible="not ipr_can_decide"/>
            </xpath>
        </field>
    </record>

    <record id="ipr_bill_to_approve_view_list" model="ir.ui.view">
        <field name="name">account.move.list.ipr.to.approve</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Bills to Approve" create="0" delete="0">
                <field name="name" string="Bill"/>
                <field name="partner_id" string="Supplier"/>
                <field name="ref" string="Reference"/>
                <field name="amount_total" string="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="ipr_exception_kinds"/>
                <field name="ipr_waiting_since" string="Waiting Since"/>
            </list>
        </field>
    </record>

    <record id="ipr_bill_to_approve_view_form" model="ir.ui.view">
        <field name="name">account.move.form.ipr.to.approve</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <page name="ipr_reconciliation" position="attributes">
                <attribute name="autofocus">autofocus</attribute>
            </page>
        </field>
    </record>

    <record id="ipr_bill_to_approve_action" model="ir.actions.act_window">
        <field name="name">Bills to Approve</field>
        <field name="res_model">account.move</field>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('ipr_state', '=', 'waiting')]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_ipr_waiting': 1}</field>
        <field name="search_view_id" ref="account.view_account_bill_filter"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('ipr_bill_to_approve_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('ipr_bill_to_approve_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bills waiting for approval</p>
        </field>
    </record>

    <menuitem id="ipr_bill_to_approve_menu_account"
              name="Bills to Approve"
              parent="account.menu_finance_payables"
              action="ipr_bill_to_approve_action"
              groups="account.group_account_manager"
              sequence="15"/>
    <menuitem id="ipr_bill_to_approve_menu_purchase"
              name="Bills to Approve"
              parent="purchase.menu_procurement_management"
              action="ipr_bill_to_approve_action"
              groups="purchase.group_purchase_manager"
              sequence="25"/>
</odoo>
