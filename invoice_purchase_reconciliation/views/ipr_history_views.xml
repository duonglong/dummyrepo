<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ipr_history_view_list" model="ir.ui.view">
        <field name="name">ipr.history.list</field>
        <field name="model">ipr.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="move_name" string="Bill"/>
                <field name="partner_name" string="Supplier"/>
                <field name="bill_reference"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="event" widget="badge"/>
                <field name="tolerances_display"/>
                <field name="exceptions_display"/>
                <field name="comment"/>
            </list>
        </field>
    </record>

    <record id="ipr_history_view_search" model="ir.ui.view">
        <field name="name">ipr.history.search</field>
        <field name="model">ipr.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_name" string="Supplier"/>
                <field name="bill_reference"/>
                <field name="move_name" string="Bill"/>
                <filter name="filter_check" string="Check" domain="[('event', '=', 'check')]"/>
                <filter name="filter_approve" string="Approve" domain="[('event', '=', 'approve')]"/>
                <filter name="filter_reject" string="Reject" domain="[('event', '=', 'reject')]"/>
                <filter name="filter_reset" string="Reset" domain="[('event', '=', 'reset')]"/>
                <filter name="filter_delete" string="Deleted" domain="[('event', '=', 'delete')]"/>
                <group>
                    <filter name="group_bill" string="Bill" context="{'group_by': 'move_name'}"/>
                    <filter name="group_supplier" string="Supplier" context="{'group_by': 'partner_name'}"/>
                    <filter name="group_event" string="Event" context="{'group_by': 'event'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ipr_history_action" model="ir.actions.act_window">
        <field name="name">Reconciliation History</field>
        <field name="res_model">ipr.history</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No reconciliation history yet</p>
        </field>
    </record>

    <menuitem id="ipr_history_menu"
              name="Reconciliation History"
              parent="account.menu_finance_reports"
              action="ipr_history_action"
              groups="account.group_account_invoice"
              sequence="90"/>
</odoo>
