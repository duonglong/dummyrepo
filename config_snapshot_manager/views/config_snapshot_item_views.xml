<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="config_snapshot_item_view_list" model="ir.ui.view">
        <field name="name">config.snapshot.item.list</field>
        <field name="model">config.snapshot.item</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="parameter_id"/>
                <field name="key"/>
                <field name="value_display"/>
                <field name="sensitive"/>
            </list>
        </field>
    </record>

    <record id="config_snapshot_item_view_form" model="ir.ui.view">
        <field name="name">config.snapshot.item.form</field>
        <field name="model">config.snapshot.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="parameter_id"/>
                        <field name="key"/>
                        <field name="value_display"/>
                        <field name="sensitive"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="config_snapshot_item_action" model="ir.actions.act_window">
        <field name="name">Covered settings</field>
        <field name="res_model">config.snapshot.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
