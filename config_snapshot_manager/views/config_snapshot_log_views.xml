<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="config_snapshot_log_view_list" model="ir.ui.view">
        <field name="name">config.snapshot.log.list</field>
        <field name="model">config.snapshot.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="log_type"/>
                <field name="user_id"/>
                <field name="date"/>
                <field name="key"/>
                <field name="change_type"/>
                <field name="old_value"/>
                <field name="new_value"/>
                <field name="setting_count"/>
                <field name="added_count"/>
                <field name="modified_count"/>
                <field name="removed_count"/>
            </list>
        </field>
    </record>

    <record id="config_snapshot_log_view_form" model="ir.ui.view">
        <field name="name">config.snapshot.log.form</field>
        <field name="model">config.snapshot.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="log_type"/>
                            <field name="user_id"/>
                            <field name="date"/>
                            <field name="file_name"/>
                        </group>
                        <group>
                            <field name="setting_count"/>
                            <field name="added_count"/>
                            <field name="modified_count"/>
                            <field name="removed_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="key"/>
                        <field name="change_type"/>
                        <field name="old_value"/>
                        <field name="new_value"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="config_snapshot_log_view_search" model="ir.ui.view">
        <field name="name">config.snapshot.log.search</field>
        <field name="model">config.snapshot.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="key"/>
                <field name="user_id"/>
                <filter string="Exports" name="exports" domain="[('log_type', '=', 'export')]"/>
                <filter string="Imports" name="imports" domain="[('log_type', '=', 'import')]"/>
                <filter string="Changes" name="changes" domain="[('log_type', '=', 'change')]"/>
                <separator/>
                <filter string="Date" name="filter_date" date="date"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by': 'log_type'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="config_snapshot_log_action" model="ir.actions.act_window">
        <field name="name">Audit log</field>
        <field name="res_model">config.snapshot.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
