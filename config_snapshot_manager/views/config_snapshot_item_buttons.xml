<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="config_snapshot_item_view_list_buttons" model="ir.ui.view">
        <field name="name">config.snapshot.item.list.buttons</field>
        <field name="model">config.snapshot.item</field>
        <field name="inherit_id" ref="config_snapshot_item_view_list"/>
        <field name="arch" type="xml">
            <list position="inside">
                <header>
                    <button name="%(config_snapshot_export_action)d" type="action"
                            string="Export" display="always"/>
                    <button name="%(config_snapshot_import_action)d" type="action"
                            string="Import" display="always"/>
                </header>
            </list>
        </field>
    </record>
</odoo>
