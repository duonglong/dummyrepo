<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="config_snapshot_import_view_form" model="ir.ui.view">
        <field name="name">config.snapshot.import.form</field>
        <field name="model">config.snapshot.import</field>
        <field name="arch" type="xml">
            <form string="Import settings">
                <field name="state" invisible="1"/>
                <group invisible="state != 'upload'">
                    <field name="file" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <group invisible="state != 'review'">
                    <group>
                        <field name="added_count"/>
                        <field name="modified_count"/>
                        <field name="removed_count"/>
                        <field name="difference_count"/>
                    </group>
                </group>
                <field name="line_ids" readonly="1" invisible="state != 'review'">
                    <list create="false" delete="false"
                          decoration-success="change_type == 'added'"
                          decoration-warning="change_type == 'modified'"
                          decoration-danger="change_type == 'removed'">
                        <field name="change_type"/>
                        <field name="key"/>
                        <field name="current_value"/>
                        <field name="file_value"/>
                        <field name="sensitive" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button string="Compare" name="action_compare" type="object"
                            class="btn-primary" invisible="state != 'upload'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="config_snapshot_import_action" model="ir.actions.act_window">
        <field name="name">Import</field>
        <field name="res_model">config.snapshot.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_config_snapshot_import" name="Import"
              parent="menu_config_snapshot_root" action="config_snapshot_import_action"
              sequence="30" groups="base.group_system"/>
</odoo>
