<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="form_view_field_organizer.FvfLayoutLines">
        <div class="o_fvf_layout_lines" t-ref="this.blocksRef">
            <div t-foreach="this.blocks" t-as="block" t-key="block.key" class="o_fvf_line_block" t-att-data-section-key="block.key">
                <h4 class="o_fvf_line_block_title">
                    <t t-if="!block.sectionId">Original place (not in a section)</t>
                    <t t-else="" t-out="block.title"/>
                </h4>
                <div t-foreach="block.lines" t-as="line" t-key="line.resId or line._virtualId"
                     class="o_fvf_line_row" t-att-data-line-id="line.resId or line._virtualId"
                     tabindex="0" role="button"
                     t-on-click="() => this.openLine(line)"
                     t-on-keydown="(ev) => this.onRowKeydown(ev, line)">
                    <span t-if="!this.props.readonly" class="o_fvf_line_handle oi" data-icon="drag_indicator" title="Drag to move" aria-label="Drag to move"/>
                    <span class="o_fvf_line_label" t-out="line.data.field_label"/>
                    <span class="o_fvf_line_groups">
                        <span t-foreach="this.groupNames(line)" t-as="group" t-key="group_index" class="badge text-bg-secondary" t-out="group"/>
                    </span>
                    <span class="o_fvf_line_condition text-muted" t-out="line.data.condition_summary"/>
                    <span t-if="line.data.missing" class="o_fvf_line_missing text-danger">
                        <i class="oi" data-icon="warning" aria-hidden="true"/> Missing field
                    </span>
                </div>
            </div>
        </div>
    </t>
</templates>
