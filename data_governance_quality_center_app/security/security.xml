<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_dgq" model="res.groups.privilege">
        <field name="name">Data Quality</field>
        <field name="sequence">70</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_dgq_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dgq"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_dgq_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_dgq"/>
        <field name="implied_ids" eval="[Command.link(ref('group_dgq_viewer'))]"/>
    </record>

    <record id="group_dgq_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_dgq"/>
        <field name="implied_ids" eval="[Command.link(ref('group_dgq_operator'))]"/>
    </record>

    <record id="group_dgq_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_dgq"/>
        <field name="implied_ids" eval="[Command.link(ref('group_dgq_manager'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_dgq_admin'))]"/>
    </record>
</odoo>
