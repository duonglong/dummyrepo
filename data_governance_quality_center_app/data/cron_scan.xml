<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_dgq_scan" model="ir.cron">
        <field name="name">Data Quality: run scans</field>
        <field name="model_id" ref="model_data_quality_scan"/>
        <field name="state">code</field>
        <field name="code">model._dgq_run_next()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="seq_dgq_scan" model="ir.sequence">
        <field name="name">Data Quality Scan</field>
        <field name="code">data.quality.scan</field>
        <field name="prefix">SCAN/</field>
        <field name="padding">5</field>
    </record>
</odoo>
