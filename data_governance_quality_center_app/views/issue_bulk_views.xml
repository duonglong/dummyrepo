<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="issue_bulk_view_form" model="ir.ui.view">
        <field name="name">data.quality.issue.bulk.form</field>
        <field name="model">data.quality.issue.bulk</field>
        <field name="arch" type="xml">
            <form>
                <field name="issue_ids" invisible="1"/>
                <group invisible="result_message">
                    <field name="action" widget="radio"/>
                    <field name="user_id" invisible="action != 'assign'" required="action == 'assign'"
                           options="{'no_create': True}"/>
                    <field name="priority" invisible="action != 'priority'" required="action == 'priority'"/>
                    <field name="deadline" invisible="action != 'deadline'" required="action == 'deadline'"/>
                    <field name="reason" invisible="action != 'ignore'" required="action == 'ignore'"/>
                </group>
                <field name="result_message" invisible="not result_message" nolabel="1"/>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"
                            invisible="result_message"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="issue_bulk_action" model="ir.actions.act_window">
        <field name="name">Change Issues</field>
        <field name="res_model">data.quality.issue.bulk</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_issue_ids': active_ids}</field>
        <field name="binding_model_id" ref="model_data_quality_issue"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('group_dgq_operator'))]"/>
    </record>

    <record id="issue_analysis_view_pivot" model="ir.ui.view">
        <field name="name">data.quality.issue.pivot</field>
        <field name="model">data.quality.issue</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="rule_id" type="row"/>
                <field name="user_id" type="col"/>
                <field name="resolution_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="issue_analysis_view_search" model="ir.ui.view">
        <field name="name">data.quality.issue.analysis.search</field>
        <field name="model">data.quality.issue</field>
        <field name="arch" type="xml">
            <search>
                    <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'res_model'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_assignee" string="Assignee" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="issue_analysis_action" model="ir.actions.act_window">
        <field name="name">Issue Analysis</field>
        <field name="res_model">data.quality.issue</field>
        <field name="view_mode">pivot</field>
        <field name="domain">[('state', '=', 'resolved')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Resolve an issue to see its resolution time.</p>
        </field>
        <field name="search_view_id" ref="issue_analysis_view_search"/>
    </record>

    <menuitem id="menu_dgq_issue_analysis" name="Issue Analysis" parent="menu_dgq_root"
              action="issue_analysis_action" sequence="45" groups="group_dgq_viewer"/>
</odoo>
