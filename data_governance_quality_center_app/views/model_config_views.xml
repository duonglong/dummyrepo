<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="model_config_view_list" model="ir.ui.view">
        <field name="name">data.quality.model.config.list</field>
        <field name="model">data.quality.model.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_id"/>
                <field name="model_name"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="model_config_view_form" model="ir.ui.view">
        <field name="name">data.quality.model.config.form</field>
        <field name="model">data.quality.model.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="model_name"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="model_config_view_search" model="ir.ui.view">
        <field name="name">data.quality.model.config.search</field>
        <field name="model">data.quality.model.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id"/>
                <field name="model_name"/>
                <filter name="supported" string="Supported" domain="[('status', '=', 'supported')]"/>
                <filter name="excluded" string="Excluded" domain="[('status', '=', 'excluded')]"/>
                <filter name="restricted" string="Restricted" domain="[('status', '=', 'restricted')]"/>
            </search>
        </field>
    </record>

    <record id="model_config_action" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">data.quality.model.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="field_config_view_list" model="ir.ui.view">
        <field name="name">data.quality.field.config.list</field>
        <field name="model">data.quality.field.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_id"/>
                <field name="field_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="field_config_view_form" model="ir.ui.view">
        <field name="name">data.quality.field.config.form</field>
        <field name="model">data.quality.field.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="field_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="model_id"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="field_config_view_search" model="ir.ui.view">
        <field name="name">data.quality.field.config.search</field>
        <field name="model">data.quality.field.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="field_id"/>
                <field name="model_id"/>
                <filter name="excluded" string="Excluded" domain="[('status', '=', 'excluded')]"/>
                <filter name="sensitive" string="Sensitive" domain="[('status', '=', 'sensitive')]"/>
                <filter name="allowed" string="Allowed" domain="[('status', '=', 'allowed')]"/>
                <group>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="field_config_action" model="ir.actions.act_window">
        <field name="name">Fields</field>
        <field name="res_model">data.quality.field.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
