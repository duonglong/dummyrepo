<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="merge_wizard_view_form" model="ir.ui.view">
        <field name="name">data.quality.merge.wizard.form</field>
        <field name="model">data.quality.merge.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="group_id" invisible="1"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_ids" invisible="1"/>
                    <field name="kept_res_id"/>
                    <field name="archive_names"/>
                    <field name="reversible" widget="boolean"/>
                    <field name="irreversible_reason" invisible="reversible"/>
                    <field name="link_summary" invisible="1"/>
                    <field name="links_to_move"/>
                </group>
                <field name="value_line_ids" readonly="0">
                    <list editable="bottom" create="0" delete="0" decoration-warning="differs">
                        <field name="res_model" column_invisible="1"/>
                        <field name="field_name" column_invisible="1"/>
                        <field name="field_label" readonly="1" force_save="1"/>
                        <field name="kept_value" readonly="1" force_save="1"/>
                        <field name="source_res_id"/>
                        <field name="value_display"/>
                        <field name="differs" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
