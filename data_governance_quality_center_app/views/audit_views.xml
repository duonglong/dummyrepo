<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="audit_view_form" model="ir.ui.view">
        <field name="name">data.quality.audit.form</field>
        <field name="model">data.quality.audit</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="event"/>
                            <field name="user_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="record_name"/>
                            <field name="field_names"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="changes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="audit_view_search" model="ir.ui.view">
        <field name="name">data.quality.audit.search</field>
        <field name="model">data.quality.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="record_name"/>
                <field name="res_model"/>
                <field name="user_id"/>
                <field name="event"/>
                <group>
                    <filter name="group_event" string="Event" context="{'group_by': 'event'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="audit_purge_view_form" model="ir.ui.view">
        <field name="name">data.quality.audit.purge.form</field>
        <field name="model">data.quality.audit.purge</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_before"/>
                    <field name="entry_count"/>
                </group>
                <footer>
                    <button name="action_purge" type="object" string="Purge" class="btn-primary"
                            confirm="The entries are deleted for good. Continue?"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="audit_purge_action" model="ir.actions.act_window">
        <field name="name">Purge Audit Trail</field>
        <field name="res_model">data.quality.audit.purge</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="audit_export_view_form" model="ir.ui.view">
        <field name="name">data.quality.audit.export.form</field>
        <field name="model">data.quality.audit.export</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="event"/>
                        <field name="file_format"/>
                    </group>
                    <group>
                        <field name="user_ids" widget="many2many_tags"/>
                        <field name="model_ids" widget="many2many_tags"/>
                        <field name="company_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Export" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="audit_export_action" model="ir.actions.act_window">
        <field name="name">Export Audit Trail</field>
        <field name="res_model">data.quality.audit.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="audit_action" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">data.quality.audit</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_report_audit" model="ir.actions.report">
        <field name="name">Audit Trail</field>
        <field name="model">data.quality.audit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">data_governance_quality_center_app.report_audit</field>
    </record>

    <template id="report_audit">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <h2>Audit Trail</h2>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Time</th><th>Event</th><th>User</th><th>Company</th><th>Model</th>
                                <th>Record ID</th><th>Record</th><th>Fields</th><th>Values</th><th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="entry">
                                <td><span t-field="entry.date"/></td>
                                <td><span t-field="entry.event"/></td>
                                <td><span t-field="entry.user_id"/></td>
                                <td><span t-field="entry.company_id"/></td>
                                <td><span t-field="entry.res_model"/></td>
                                <td><span t-field="entry.res_id"/></td>
                                <td><span t-field="entry.record_name"/></td>
                                <td><span t-field="entry.field_names"/></td>
                                <td><span t-out="entry.changes"/></td>
                                <td><span t-field="entry.description"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
    <record id="audit_view_list" model="ir.ui.view">
        <field name="name">data.quality.audit.list</field>
        <field name="model">data.quality.audit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <header>
                    <button name="%(audit_export_action)d" type="action" string="Export"
                            display="always"/>
                    <button name="%(audit_purge_action)d" type="action" string="Purge"
                            display="always"/>
                </header>
                <field name="date"/>
                <field name="event"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="res_model"/>
                <field name="record_name"/>
                <field name="field_names"/>
                <field name="description"/>
            </list>
        </field>
    </record>
</odoo>
