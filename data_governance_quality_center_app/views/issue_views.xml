<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="issue_view_list" model="ir.ui.view">
        <field name="name">data.quality.issue.list</field>
        <field name="model">data.quality.issue</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" duplicate="0">
                <field name="name"/>
                <field name="severity" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="is_illustrative" widget="boolean" optional="show"/>
                <field name="priority"/>
                <field name="user_id"/>
                <field name="deadline"/>
                <field name="last_found"/>
                <field name="company_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="issue_view_form" model="ir.ui.view">
        <field name="name">data.quality.issue.form</field>
        <field name="model">data.quality.issue</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" duplicate="0">
                <header>
                    <button name="action_start" type="object" string="In Progress" class="btn-primary"
                            invisible="state not in ('new', 'assigned')"
                            groups="data_governance_quality_center_app.group_dgq_operator"/>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-primary"
                            invisible="state not in ('new', 'assigned', 'in_progress')"
                            groups="data_governance_quality_center_app.group_dgq_operator"/>
                    <button name="action_ignore" type="object" string="Ignore"
                            invisible="state not in ('new', 'assigned', 'in_progress')"
                            groups="data_governance_quality_center_app.group_dgq_operator"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state not in ('resolved', 'ignored')"
                            groups="data_governance_quality_center_app.group_dgq_operator"/>
                    <button name="action_open_record" type="object" string="Open Record"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned,in_progress,resolved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Illustrative" bg_color="text-bg-warning" invisible="not is_illustrative"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Finding">
                            <field name="rule_id" readonly="1"/>
                            <field name="rule_version" readonly="1"/>
                            <field name="record_name" readonly="1"/>
                            <field name="severity" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="explanation" readonly="1"/>
                        </group>
                        <group string="Work">
                            <field name="user_id"/>
                            <field name="priority"/>
                            <field name="deadline"/>
                            <field name="ignore_reason" invisible="state != 'ignored'"/>
                        </group>
                        <group string="Found">
                            <field name="first_found" readonly="1"/>
                            <field name="first_scan_id" readonly="1"/>
                            <field name="last_found" readonly="1"/>
                            <field name="scan_id" readonly="1"/>
                        </group>
                        <group string="Resolution" invisible="state != 'resolved'">
                            <field name="date_resolved"/>
                            <field name="resolution_hours" widget="float_time"/>
                            <field name="resolved_by_scan"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="issue_view_kanban" model="ir.ui.view">
        <field name="name">data.quality.issue.kanban</field>
        <field name="model">data.quality.issue</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" create="0" delete="0" records_draggable="0" group_create="0"
                    group_edit="0" group_delete="0" quick_create="0">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div class="d-flex flex-wrap gap-1">
                            <field name="severity" widget="badge"/>
                            <field name="priority" widget="badge"/>
                        </div>
                        <footer class="pt-1">
                            <field name="deadline"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="issue_action" model="ir.actions.act_window">
        <field name="name">Issues</field>
        <field name="res_model">data.quality.issue</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Run a scan to find issues.</p>
        </field>
    </record>
</odoo>
