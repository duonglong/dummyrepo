<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="scan_view_list" model="ir.ui.view">
        <field name="name">data.quality.scan.list</field>
        <field name="model">data.quality.scan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state" widget="badge"/>
                <field name="progress" widget="progressbar"/>
                <field name="records_scanned"/>
                <field name="checks_failed"/>
                <field name="user_id"/>
                <field name="date_queued"/>
            </list>
        </field>
    </record>

    <record id="scan_view_form" model="ir.ui.view">
        <field name="name">data.quality.scan.form</field>
        <field name="model">data.quality.scan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary"
                            invisible="state not in ('draft', 'failed', 'cancelled')"
                            groups="data_governance_quality_center_app.group_dgq_operator"/>
                    <button name="action_resume" type="object" string="Resume" class="btn-primary"
                            invisible="state != 'failed'"
                            groups="data_governance_quality_center_app.group_dgq_operator"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('queued', 'running')"
                            groups="data_governance_quality_center_app.group_dgq_operator"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="rule_ids" widget="many2many_tags" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="model_ids" widget="many2many_tags" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="company_ids" widget="many2many_tags" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Progress">
                            <field name="progress" widget="progressbar"/>
                            <field name="records_scanned"/>
                            <field name="checks_passed"/>
                            <field name="checks_failed"/>
                            <field name="checks_not_applicable"/>
                            <field name="user_id"/>
                            <field name="date_queued"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group string="Rules not run" invisible="not rules_not_run_text">
                        <field name="rules_not_run_text" nolabel="1"/>
                    </group>
                    <group invisible="not error_message">
                        <field name="error_message"/>
                    </group>
                    <notebook>
                        <page string="Results">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="rule_id"/>
                                    <field name="res_model"/>
                                    <field name="res_id"/>
                                    <field name="severity"/>
                                    <field name="explanation"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="scan_action" model="ir.actions.act_window">
        <field name="name">Scans</field>
        <field name="res_model">data.quality.scan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
